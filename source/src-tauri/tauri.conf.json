{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Zephyr",
    "identifier":  "local.skininjector.experimental",
    "build":  {
                  "beforeDevCommand":  "pnpm dev:injector",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "pnpm build:injector",
                  "frontendDist":  "../dist-injector"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Zephyr",
                                    "width":  480,
                                    "height":  710,
                                    "minWidth":  440,
                                    "minHeight":  640,
                                    "decorations":  true,
                                    "resizable":  true,
                                    "transparent":  false,
                                    "visible":  false,
                                    "backgroundColor":  "#090909"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027 ipc: http://ipc.localhost; img-src \u0027self\u0027 asset: data: http://asset.localhost ltk-asset: http://ltk-asset.localhost; connect-src \u0027self\u0027 ipc: http://ipc.localhost asset: http://asset.localhost ltk-asset: http://ltk-asset.localhost; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; font-src \u0027self\u0027 data:",
                                 "dangerousDisableAssetCspModification":  [
                                                                              "style-src"
                                                                          ],
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "**"
                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "resources":  {
                                     "resources/ltk_patcher_host.exe":  "ltk_patcher_host.exe",
                                     "resources/ltk_patcher_dll.dll":  "ltk_patcher_dll.dll",
                                     "resources/r3nz/R3nzSkin.dll":  "r3nz/R3nzSkin.dll",
                                     "resources/r3nz/official-loader.exe":  "r3nz/official-loader.exe"
                                 },
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          },
                                   "nsis":  {
                                                "installerHooks":  "./windows/installer-hooks.nsh",
                                                "installMode":  "perMachine",
                                                "installerIcon":  "icons/icon.ico",
                                                "uninstallerIcon":  "icons/icon.ico",
                                                "headerImage":  "icons/installer-header.bmp",
                                                "uninstallerHeaderImage":  "icons/installer-header.bmp"
                                            }
                               },
                   "macOS":  {
                                 "minimumSystemVersion":  "10.15"
                             },
                   "createUpdaterArtifacts":  false
               },
    "plugins":  {
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  [
                                                                      "skininjector"
                                                                  ]
                                                  }
                                  }
                },
    "mainBinaryName":  "zephyr"
}